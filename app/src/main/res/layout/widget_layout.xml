<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 1. ORA: Outfit SemiBold (~78sp), spessore bold ma non bold, leggermente più grande -->
    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:textAlignment="center"
        android:fontFamily="@font/outfit_semibold"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:letterSpacing="-0.01"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="10"
        android:textColor="#FFFFFFFF"
        android:textSize="78sp" />

    <!-- 2. DATA: Outfit Regular (~19sp), margin-top: 2dp, opacity: 0.9 -->
    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textAlignment="center"
        android:fontFamily="@font/outfit_regular"
        android:format12Hour="EEEE d MMMM"
        android:format24Hour="EEEE d MMMM"
        android:includeFontPadding="false"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="#E6FFFFFF"
        android:textSize="19sp" />

    <!-- 3. BATTERIA: Pillola Orizzontale Minimal (Stile 1), margin-top: 14dp, gap: 6dp -->
    <LinearLayout
        android:id="@+id/battery_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Percentuale (85%) PRIMA dell'icona: Outfit SemiBold (~24sp) -->
        <TextView
            android:id="@+id/battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/outfit_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:text="85%"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <!-- Icona Pillola Orizzontale DOPO la percentuale -->
        <ImageView
            android:id="@+id/battery_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/battery"
            android:src="@drawable/ic_battery_std" />
    </LinearLayout>

</LinearLayout>
