<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 1. ORA: 76sp Google Sans Medium (Nativo Pixel, nitido come nella preview) -->
    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:textAlignment="center"
        android:fontFamily="google-sans-medium"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="#FFFFFFFF"
        android:textSize="76sp" />

    <!-- 2. DATA: 19sp Google Sans Regular (Nativo Pixel) -->
    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:textAlignment="center"
        android:fontFamily="google-sans"
        android:format12Hour="EEEE d MMMM"
        android:format24Hour="EEEE d MMMM"
        android:includeFontPadding="false"
        android:shadowColor="#40000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textColor="#E6FFFFFF"
        android:textSize="19sp" />

    <!-- 3. BATTERIA: Percentuale 24sp + Icona Verticale con badge -->
    <LinearLayout
        android:id="@+id/battery_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Percentuale 24sp Google Sans Medium PRIMA dell'icona -->
        <TextView
            android:id="@+id/battery_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="google-sans-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="85%"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <!-- Icona Batteria Verticale (con badge circolare nell'angolo se in carica) -->
        <ImageView
            android:id="@+id/battery_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/battery"
            android:src="@drawable/ic_battery_std" />
    </LinearLayout>

</LinearLayout>
